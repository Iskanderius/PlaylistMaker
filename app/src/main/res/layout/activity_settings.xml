<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings"
    tools:context=".SettingsActivity"
    style="@style/LinearLayoutStyleBackground">

    <LinearLayout
        style="@style/LinearLayoutStyleForeground"
        android:layout_weight="10">

        <LinearLayout
            style="@style/LinearLayoutStyleForeground"
            android:layout_weight="5"
            android:id="@+id/backSettings">

            <ImageView
                style="@style/ImageViewStyle"
                android:src="@drawable/arrow" />
        </LinearLayout>

        <LinearLayout
            style="@style/LinearLayoutStyleForeground"
            android:layout_weight="1">


            <TextView
                style="@style/TextStyleTopic2"
                android:text="@string/settings" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        style="@style/LinearLayoutStyleForeground"
        android:orientation="vertical"
        android:layout_weight="1"
        android:paddingTop="@dimen/paddingHeader">

        <androidx.appcompat.widget.SwitchCompat
            style="@style/SwitchCompatStyle"
            android:text="@string/blackTheme"

            />
        <TextView
            style="@style/TextStyleUsual"
            android:text="@string/share"
            app:drawableEndCompat = "@drawable/share"
            android:layout_weight="1"
            />
        <TextView
            style="@style/TextStyleUsual"
            android:text="@string/writeMessage"
            app:drawableEndCompat = "@drawable/man"
            android:layout_weight="1"
            />
        <TextView
            style="@style/TextStyleUsual"
            android:text="@string/readDocument"
            app:drawableEndCompat = "@drawable/more"
            android:layout_weight="1"
            />

        <LinearLayout
            style="@style/LinearLayoutStyleForeground"
            android:layout_height="0dp"
            android:layout_weight="5">
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings"
    tools:context=".SettingsActivity"
    style="@style/StyleBackground">

    <LinearLayout
        style="@style/UsualLinearLayoutStyle"
        android:layout_weight="10">

        <LinearLayout
            style="@style/UsualLinearLayoutStyle"
            android:layout_weight="5"
            android:id="@+id/backSettings">

            <ImageView
                style="@style/ImageViewStyle"
                android:src="@drawable/arrow" />

        </LinearLayout>

        <LinearLayout
            style="@style/UsualLinearLayoutStyle"
            android:layout_weight="1">

            <TextView
                style="@style/TextStyle"
                android:text="@string/settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        style="@style/UsualLinearLayoutStyle"
        android:orientation="vertical"
        android:layout_weight="1"
        android:paddingTop="@dimen/marginUsual">

        <androidx.appcompat.widget.SwitchCompat
            style="@style/SwitchCompatStyle"
            android:text="@string/blackTheme"
            />

        <TextView
            style="@style/TextStyle"
            android:text="@string/share"
            app:drawableEndCompat = "@drawable/share"
            android:layout_weight="1"
            android:id="@+id/shareApp"
            android:textSize="@dimen/smallText"
        />

        <TextView
            style="@style/TextStyle"
            android:text="@string/writeMessage"
            app:drawableEndCompat = "@drawable/man"
            android:layout_weight="1"
            android:id="@+id/WriteToSupport"
            android:textSize="@dimen/smallText"
            />

        <TextView
            style="@style/TextStyle"
            android:text="@string/readDocument"
            app:drawableEndCompat = "@drawable/more"
            android:layout_weight="1"
            android:id="@+id/UserContract"
            android:textSize="@dimen/smallText"
            />

        <LinearLayout
            style="@style/UsualLinearLayoutStyle"
            android:layout_height="@dimen/Null"
            android:layout_weight="5">
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

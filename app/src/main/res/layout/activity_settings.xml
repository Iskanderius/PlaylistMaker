<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings"
    tools:context=".SettingsActivity"
    style="@style/StyleBackground"
    android:weightSum="1"
    >

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/TittleSetting"
        android:layout_width="match_parent"
        android:layout_height="@dimen/Null"
        android:layout_weight="0.07"
        app:title="@string/settings"
        app:navigationIcon="@drawable/arrow"
        android:textSize="@dimen/bigText"
        app:navigationIconTint="?attr/colorPrimaryVariant"
        />

    <androidx.appcompat.widget.SwitchCompat
        android:text="@string/blackTheme"
        android:layout_width="match_parent"
        android:layout_height="@dimen/Null"
        android:scaleType="centerInside"
        android:layout_gravity="end"
        android:layout_weight="0.1"
        android:gravity="center_vertical|start"
        android:textSize="@dimen/smallText"
        app:thumbTint="?attr/colorOnPrimary"
        app:trackTint="?attr/colorOnSecondary"
        android:paddingStart="@dimen/switchPadding"
        android:paddingEnd="@dimen/shortDistance"
        />

    <TextView
        android:text="@string/share"
        app:drawableEndCompat = "@drawable/share"
        android:id="@+id/shareApp"
        android:textSize="@dimen/smallText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/Null"
        android:layout_weight="0.1"
        android:gravity="center_vertical|start"
        android:textColor="?attr/colorPrimaryVariant"
        android:fontFamily="@font/ys_display_medium"
        app:drawableTint="?attr/colorSecondaryVariant"
        android:layout_marginHorizontal="@dimen/marginUsual"
        />

    <TextView
        android:text="@string/writeMessage"
        app:drawableEndCompat = "@drawable/man"
        android:id="@+id/WriteToSupport"
        android:textSize="@dimen/smallText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/Null"
        android:layout_weight="0.1"
        android:gravity="center_vertical|start"
        android:textColor="?attr/colorPrimaryVariant"
        android:fontFamily="@font/ys_display_medium"
        app:drawableTint="?attr/colorSecondaryVariant"
        android:layout_marginHorizontal="@dimen/marginUsual"
        />

    <TextView

        android:text="@string/readDocument"
        app:drawableEndCompat = "@drawable/more"
        android:id="@+id/UserContract"
        android:textSize="@dimen/smallText"
        android:layout_width="match_parent"
        android:layout_height="@dimen/Null"
        android:layout_weight="0.1"
        android:gravity="center_vertical|start"
        android:textColor="?attr/colorPrimaryVariant"
        android:fontFamily="@font/ys_display_medium"
        app:drawableTint="?attr/colorSecondaryVariant"
        android:layout_marginHorizontal="@dimen/marginUsual"
        />

</LinearLayout>

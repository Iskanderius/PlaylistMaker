<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:id="@+id/main"
              style="@style/StyleBackground"
              android:background="?attr/colorBackgroundFloating"
    >

    <com.google.android.material.appbar.MaterialToolbar
        android:layout_width="match_parent"
        android:layout_height="@dimen/Null"
        android:layout_weight="1.5"
        app:title="@string/Header"
        app:titleTextColor="@color/YpWhite"
        />

    <com.google.android.material.button.MaterialButton
        app:icon="@drawable/loupe"
        android:id="@+id/button1"
        android:text="@string/search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/Null"
        android:layout_weight="5"
        android:layout_marginStart="@dimen/marginUsual"
        android:layout_marginEnd="@dimen/marginUsual"
        app:cornerRadius="16sp"
       />

<com.google.android.material.button.MaterialButton
    app:icon="@drawable/media"
    android:id="@+id/button2"
    android:text="@string/media"
    android:layout_width="match_parent"
    android:layout_height="@dimen/Null"
    android:layout_weight="5"
    android:layout_marginStart="@dimen/marginUsual"
    android:layout_marginEnd="@dimen/marginUsual"
    app:cornerRadius="16sp"
    />

<com.google.android.material.button.MaterialButton

    app:icon="@drawable/setting"
    android:id="@+id/button3"
    android:text="@string/settings"
    android:layout_width="match_parent"
    android:layout_height="@dimen/Null"
    android:layout_weight="5"
    android:layout_marginStart="@dimen/marginUsual"
    android:layout_marginEnd="@dimen/marginUsual"
    app:cornerRadius="16sp"
    />

</LinearLayout>
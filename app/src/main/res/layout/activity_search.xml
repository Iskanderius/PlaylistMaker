<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search"
    tools:context=".SearchActivity"
    style="@style/StyleBackground">

    <LinearLayout
        style="@style/UsualLinearLayoutStyle"
        android:layout_height="@dimen/Null"
        android:layout_weight="1.3"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/layout_marginTop">

        <LinearLayout
            style="@style/UsualLinearLayoutStyle"
            android:layout_weight="7"
            android:id="@+id/backSettings">

            <ImageView
                style="@style/ImageViewStyle"
                android:src="@drawable/arrow"
                />

        </LinearLayout>

        <LinearLayout
            style="@style/UsualLinearLayoutStyle"
            android:layout_weight="1">

            <TextView
                style="@style/TextStyle"
                android:text="@string/search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|start"
                />

        </LinearLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/Null"
        android:layout_weight="1.3"
        android:layout_marginStart="@dimen/marginUsual"
        android:layout_marginEnd="@dimen/marginUsual"
        android:layout_marginTop="20sp"
        app:cardCornerRadius="@dimen/smallRadius"
        app:cardBackgroundColor="?attr/colorSurface"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            >

            <ImageView
                android:layout_width="@dimen/marginUsual"
                android:layout_height="@dimen/marginUsual"
                android:layout_gravity="center_vertical"
                android:src="@drawable/loupe"
                android:layout_marginStart="14sp"
                app:tint="?attr/colorOnSurface"

                />

            <EditText
                android:id="@+id/inputEditText"
                android:layout_width="@dimen/Null"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10sp"
                android:layout_weight="20"
                android:background="?attr/colorSurface"
                android:hint="@string/input_hint"
                android:inputType="number"
                android:maxLength="15"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurface"
                android:textCursorDrawable="@color/YpBlue"
                />

            <ImageView
                android:id="@+id/clearIcon"
                android:layout_width="@dimen/marginUsual"
                android:layout_height="@dimen/marginUsual"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_menu_close_clear_cancel"
                android:layout_marginEnd="@dimen/marginUsual"
                app:tint="?attr/colorOnSurface"
                android:visibility="gone"
                />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        style="@style/UsualLinearLayoutStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/Null"
        android:layout_weight="16">

    </LinearLayout>
</LinearLayout>

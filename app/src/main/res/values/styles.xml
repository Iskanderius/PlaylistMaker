<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextStyle"><!-- используется main PlayListmaker center_vertical|start -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/Null</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textColor">?attr/colorPrimaryVariant</item>
        <item name="android:textSize">@dimen/bigText</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:drawableTint">?attr/colorSecondaryVariant</item>
        <item name="android:layout_marginStart">@dimen/marginUsual</item>
        <item name="android:layout_marginEnd">@dimen/marginUsual</item>
    </style>

    <style name="TitleStyle">
        <item name="android:textSize">@dimen/bigText</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:gravity">center_vertical|start</item>
    </style>

    <style name="StyleBackground">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/paddingHeader</item>
    </style>

    <style name="UsualLinearLayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SwitchCompatStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/Null</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textSize">@dimen/paddingUsual</item>

        <item name="thumbTint">?attr/colorOnPrimary</item>
        <item name="trackTint">?attr/colorOnSecondary</item>
    </style>

    <style name="ImageViewStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?attr/colorPrimaryVariant</item>
    </style>

    <style name="CustomMaterialButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <!-- Скругление углов -->
        <item name="android:textColor">@color/YpBlack</item>
        <item name="android:colorBackground">@color/YpWhite</item>
        <!-- Шрифт и текст -->
        <item name="android:textSize">@dimen/bigText</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <!-- Иконка -->
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/paddingUsual</item>
        <item name="iconTint">@color/YpBlack</item>
        <!-- Скругление -->
    </style>

    <style name="ButtonCustomCorners" parent="">
        <!-- cornerSize задает радиус для всех 4 углов -->
        <item name="cornerSize">@dimen/bigRadius</item>
        <!-- Можно также указать тип скругления (rounded или cut) -->
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="MaterialToolbarStyle" parent="@style/Widget.MaterialComponents.Toolbar">
        <item name="android:titleTextColor">?attr/colorPrimaryVariant</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textSize">@dimen/bigText</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:layout_marginTop">@dimen/layout_marginTop</item>
    </style>

    <!-- For elements RecyclerView -->


    <style name="RecyclerViewTitleImage" parent="">
        <item name="android:layout_width">45sp</item>
        <item name="android:layout_height">45sp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="RecyclerViewChooseImage" parent="">
        <item name="android:layout_width">8sp</item>
        <item name="android:layout_height">14sp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="RecyclerViewTrackName" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorPrimaryVariant</item>
        <item name="android:textSize">@dimen/smallText</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="RecyclerViewTrackInfo" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorSecondaryVariant</item>
        <item name="android:textSize">@dimen/smallerText</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>

</resources>